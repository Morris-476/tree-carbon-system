# 環境變數範例檔（複製為 .env 後填入真實值，.env 不可進版控）

# Azure SQL 資料庫連線
DB_SERVER=your-server.database.windows.net
DB_NAME=tree_db
DB_USER=your_db_user
DB_PASSWORD=your_strong_password
DB_ENCRYPT=yes
DB_TRUST_CERT=no

# YOLO 模型路徑（相對於專案根目錄）
MODEL_PATH=Tree-Trunk-Segmentation/best.pt

# Flask session 密鑰（使用 python -c "import secrets; print(secrets.token_hex(32))" 產生）
SECRET_KEY=your_random_secret_key_here
